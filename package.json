{
  "name": "rehearsal-test-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run check:layout && npm test",
    "upgrade:verify": "node --import tsx scripts/verify-upgrade.mts",
    "adoption:verify": "node --import tsx scripts/verify-adoption.mts",
    "candidate:verify": "node --import tsx scripts/verify-candidate.mts",
    "onboarding:verify": "node --import tsx scripts/verify-onboarding.mts",
    "supabase:start": "supabase start --workdir projects/supabase",
    "supabase:stop": "supabase stop --workdir projects/supabase",
    "supabase:reset": "supabase db reset --workdir projects/supabase",
    "supabase:assets": "node --import tsx scripts/seed-supabase-assets.mts",
    "supabase:auth:seed": "node --import tsx scripts/seed-supabase-auth.mts",
    "supabase:auth:source": "node --import tsx scripts/open-source-auth.mts",
    "supabase:verify": "node --import tsx scripts/verify-supabase.mts",
    "supabase:auth:doctor": "npm --prefix projects/supabase run auth:doctor",
    "supabase:auth:open": "npm --prefix projects/supabase run auth:open",
    "rehearsal:verify-target": "node --import tsx scripts/verify-rehearsal-target.mts",
    "postgresql:start": "node --import tsx scripts/ensure-postgresql-volume.mts && docker compose -f projects/postgresql/compose.yaml up -d --wait",
    "postgresql:verify": "node --import tsx projects/postgresql/verify.mts",
    "postgresql:verify-target": "npm --prefix projects/postgresql run verify:target",
    "postgresql:stop": "docker compose -f projects/postgresql/compose.yaml stop",
    "postgresql:fallback:start": "node --import tsx scripts/postgresql-runtime.mts start",
    "postgresql:fallback:stop": "node --import tsx scripts/postgresql-runtime.mts stop",
    "check:layout": "node --import tsx scripts/check-layout.mts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --import tsx --test tests/*.test.mts"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@rehearsal-db/core": "0.1.0-rc.1",
    "@types/node": "22.20.5",
    "@types/pg": "^8.16.0",
    "pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}
